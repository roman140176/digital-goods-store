APP_NAME="Digital Goods Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8085

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=store
DB_USERNAME=app
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Поставщики выдачи (два независимых сервиса со своими складами)
SUPPLIER_A_URL=http://supplier-a
SUPPLIER_B_URL=http://supplier-b
SUPPLIER_TIMEOUT=3
SUPPLIER_ATTEMPTS=3

# Выдача и восстановление
DELIVERY_LOCK_SECONDS=45
DELIVERY_RECONCILE_AFTER_SECONDS=30

# Эмулятор платёжной системы стучится вебхуком через nginx
PAYMENT_WEBHOOK_URL=http://nginx/api/webhook/payment

# Бронь единицы склада при создании заказа
RESERVATION_TTL_SECONDS=300

# Админка
ADMIN_TOKEN=admin-secret-token
